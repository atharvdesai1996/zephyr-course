menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"


    if LED_SUBSYSTEM

        choice
            prompt "LED blink sleep time"
            default BLINK_SLEEP_500MS
            config BLINK_SLEEP_100MS
                bool "Fast (100ms)"
            config BLINK_SLEEP_500MS
                bool "Medium (500ms)"
            config BLINK_SLEEP_2000MS
                bool "Slow (2s)"
        endchoice

        config APP_HEARTBEAT_PERIOD_MS
            int
            default 500 if BLINK_SLEEP_500MS
            default 100 if BLINK_SLEEP_100MS
            default 2000 if BLINK_SLEEP_2000MS
            default 0

        menuconfig LED_ADVANCED
            bool "Advanced LED settings"
            if LED_ADVANCED
                config LED_BRIGHTNESS
                    int "LED brightness (0-100)"
                    default 100
                    range 0 100
                config LED_FADE_DURATION_MS
                    int "Fade duration (ms)"
                    default 500
                    range 0 5000
            endif
        menu "Expert settings"
            visible if LED_ADVANCED
            config LED_DEBUG
                bool "Enable LED debugging"
            config CUSTOM_BLINK_PATTERN
                bool "Custom blink pattern"

endmenu

endif   # LED_SUBSYSTEM

source "Kconfig.zephyr"