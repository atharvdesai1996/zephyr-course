/ {
    /* Send console/logs to lpuart1, which is wired to the Linux side (/dev/ttyHS1) */
    chosen {
        zephyr,console = &lpuart1;
        zephyr,shell-uart = &lpuart1;
    };

    aliases {
        app-led = &led3_red;
    };

    our_driver0: our_driver {
        compatible = "our,driver";
        status = "okay";
    };
    our_driver1: our_driver@1 {
        compatible = "our,driver";
        status = "okay";
    };
};